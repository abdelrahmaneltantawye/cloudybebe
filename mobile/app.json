{
  "expo": {
    "name": "CloudyBebe",
    "slug": "cloudybebe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cloudybebe",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3F0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ad694338-d8c7-45f3-9654-bb6993709dda"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudybebe.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "CloudyBebe uses Face ID to securely authenticate and protect your account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/cloudybebe-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cloudybebe.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/cloudybebe-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3F0",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#18191B"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CloudyBebe to use Face ID for secure authentication."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/cloudybebe-mark.png",
          "color": "#76867A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./locales/en.json"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ad694338-d8c7-45f3-9654-bb6993709dda"
      }
    },
    "owner": "tantawe91"
  }
}
